# Copy to .env and fill in. Never commit .env.

# Telegram: create a bot via /newbot at @BotFather
TELEGRAM_BOT_TOKEN=
# Send the bot a message, then open https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_CHAT_ID=

# Twitch app from dev.twitch.tv/console (Clips API)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Claude Haiku for titles and hooks (otherwise local Ollama)
ANTHROPIC_API_KEY=

# Paths: keep everything on E:
DATA_DIR=E:\dev\clipping-tool\data
PYTHON_BIN=E:\dev\clipping-tool\.venv\Scripts\python.exe
HF_HOME=E:\dev\cache\huggingface
OLLAMA_MODELS=E:\dev\cache\ollama
PIP_CACHE_DIR=E:\dev\cache\pip
TEMP=E:\dev\cache\tmp
TMP=E:\dev\cache\tmp

# Review via Bark push (iOS) + review page over Tailscale
BARK_URL=https://api.day.app
BARK_KEY=
# Tailscale IP of this PC; the page is only reachable from your tailnet
REVIEW_HOST=
REVIEW_PORT=8787
# Link the push opens, e.g. http://<machine>.<tailnet>.ts.net:8787
REVIEW_URL=

# Phase 2: publisher (official APIs only)
# YouTube Shorts: Google Cloud project + YouTube Data API v3 + OAuth client (Desktop app)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# TikTok: developer app with Content Posting API (Direct Post needs TikTok's audit for public posts)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
